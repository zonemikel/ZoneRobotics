Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Map1
        - /RoomCloud1
      Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 20
      Color: 160; 160; 164
      Value: true
    # Floor map built from every sweep (white = free floor, black = wall,
    # grey = unknown). ./run.sh clear empties it.
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Color Scheme: map
      Alpha: 0.7
      Draw Behind: true
      Value: true
    # Every zone of every sweep in 3D (coloured by height).
    - Class: rviz_default_plugins/PointCloud2
      Name: RoomCloud
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_cloud
      Style: Flat Squares
      Size (m): 0.02
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Decay Time: 0
      Alpha: 1
      Value: true
    # The last sweep as a classic 2D LaserScan.
    - Class: rviz_default_plugins/LaserScan
      Name: RoomScan
      Enabled: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /scan
      Style: Flat Squares
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 0; 255; 128
      Alpha: 1
      Decay Time: 0
      Value: false
    # The car itself (turns with the heading, tilts with pitch/roll).
    - Class: rviz_default_plugins/MarkerArray
      Name: Car
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_marker
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.2
      Value: true
    - Class: rviz_default_plugins/Range
      Name: Range
      Enabled: true
      Buffer Length: 1
      Color: 255; 40; 0
      Alpha: 0.4
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /range
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Max Value: 1
      Min Value: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/image_raw
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Enabled: true
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.1
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Camera:
    collapsed: false
  Height: 800
  Width: 1200
